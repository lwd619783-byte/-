{
  "name": "investment-research-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "env:check": "node scripts/dev-health.mjs",
    "env:check:json": "node scripts/dev-health.mjs --json",
    "build": "tsc -b && npm run local:typecheck && vite build && node scripts/check-financial-bundle.mjs",
    "build:check": "node scripts/check-financial-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:discovery": "node --test scripts/tests/test-discovery.node.mjs",
    "data:research": "node -e \"console.log('See docs/a-stock-data-usage-notes.md and docs/a-stock-data-field-mapping.md')\"",
    "data:universe": "node scripts/generate-stock-universe.mjs",
    "data:fetch": "npm run data:universe && python scripts/fetch-a-stock-data.py && python scripts/fetch-hk-stock-data.py",
    "data:fetch:a-stock": "npm run data:universe && python scripts/fetch-a-stock-data.py",
    "data:fetch:financials:a": "python scripts/fetch-a-share-financials.py",
    "data:validate:financials:a": "python scripts/validate-a-share-financials.py",
    "test:financials:a": "python -m unittest discover -s scripts/tests -p test_a_share_financials.py",
    "data:fetch:announcements:a": "python scripts/fetch-a-share-announcements.py",
    "data:validate:announcements:a": "python scripts/validate-a-share-announcements.py",
    "test:announcements:a": "python -m unittest discover -s scripts/tests -p test_a_share_announcements.py",
    "data:fetch:expectations:company-guidance": "node scripts/generate-company-guidance-expectations.mjs",
    "data:validate:expectations:company-guidance": "node scripts/validate-company-guidance-expectations.mjs",
    "test:expectations:company-guidance": "node --test scripts/tests/company-guidance-expectations.test.mjs scripts/tests/company-guidance-integrity.node.mjs scripts/tests/company-guidance-check.node.mjs && vitest run src/services/companyGuidanceExpectationProvider.test.ts src/components/expectation/CompanyGuidanceExpectationWorkflow.test.tsx",
    "data:observe:providers": "python scripts/observe-providers.py --provider all",
    "data:observe:financials:a": "python scripts/observe-providers.py --provider financials",
    "data:observe:announcements:a": "python scripts/observe-providers.py --provider announcements",
    "data:health:providers": "python scripts/provider-health.py",
    "data:refresh:eligibility": "python scripts/provider-health.py --strict-exit",
    "test:provider-observability": "python -m unittest discover -s scripts/tests -p test_provider_observability.py",
    "data:probe:expectations:institution-consensus": "python scripts/probe-a-share-institution-consensus.py",
    "test:expectations:institution-consensus-probe": "python -m unittest discover -s scripts/tests -p test_a_share_institution_consensus_probe.py",
    "data:probe:market-regime:p0": "python -m scripts.market_regime.cli probe --plan config/market-regime/p0-live-probe-plan.v1.json --output-root research-data/market-regime/live-probe",
    "data:build:market-regime:catalog": "python -m scripts.market_regime.cli build --input research-data/market-regime/source-catalog/catalog-seed.sample.v1.json --output research-data/market-regime/catalog/observation-catalog.sample.v1.json",
    "data:validate:market-regime:catalog": "python -m scripts.market_regime.cli validate --catalog research-data/market-regime/catalog/observation-catalog.sample.v1.json --verify-artifacts",
    "test:market-regime:all-a": "python -m unittest discover -s scripts/tests -p test_market_regime_all_a_admission.py",
    "test:market-regime:r2-e": "python -m unittest discover -s scripts/tests -p test_market_regime_r2e*.py",
    "data:build:market-regime:all-a-d3": "python -m scripts.market_regime.r2e_integration build admission",
    "data:validate:market-regime:all-a-d3": "python -m scripts.market_regime.r2e_integration validate admission",
    "data:build:market-regime:all-a": "python -m scripts.market_regime.all_a_admission build",
    "data:validate:market-regime:all-a": "python -m scripts.market_regime.all_a_admission validate",
    "test:market-regime:bse": "python -m unittest discover -s scripts/tests -p test_market_regime_bse*.py",
    "data:fetch:market-regime:bse": "python -m scripts.market_regime.bse_inventory fetch",
    "data:build:market-regime:bse": "python -m scripts.market_regime.bse_inventory build",
    "data:validate:market-regime:bse": "python -m scripts.market_regime.bse_inventory validate",
    "data:validate:market-regime:bse:compact": "python -m scripts.market_regime.bse_inventory validate-compact",
    "test:market-regime:szse": "python -m unittest discover -s scripts/tests -p test_market_regime_szse*.py",
    "data:fetch:market-regime:szse": "python -m scripts.market_regime.szse_inventory fetch",
    "data:build:market-regime:szse": "python -m scripts.market_regime.szse_inventory build",
    "data:validate:market-regime:szse": "python -m scripts.market_regime.szse_inventory validate",
    "data:validate:market-regime:szse:compact": "python -m scripts.market_regime.szse_inventory validate-compact",
    "test:market-regime:sse": "python -m unittest discover -s scripts/tests -p test_market_regime_sse*.py",
    "data:fetch:market-regime:sse": "python -m scripts.market_regime.sse_inventory fetch",
    "data:build:market-regime:sse": "python -m scripts.market_regime.sse_inventory build",
    "data:validate:market-regime:sse": "python -m scripts.market_regime.sse_inventory validate",
    "data:validate:market-regime:sse:compact": "python -m scripts.market_regime.sse_inventory validate-compact",
    "test:market-regime:historical": "python -m unittest discover -s scripts/tests -p test_market_regime_historical*.py",
    "test:market-regime:pbc": "python -m unittest discover -s scripts/tests -p test_market_regime_pbc*.py",
    "test:market-regime:csrc-c1": "python -m unittest discover -s scripts/tests -p test_market_regime_csrc*.py",
    "test:market-regime:csrc-recovery": "python -m unittest discover -s scripts/tests -p test_market_regime_csrc_recovery.py",
    "test:market-regime:csrc-c2a1": "python -m unittest discover -s scripts/tests -p test_market_regime_csrc_ipo_admission.py",
    "test:market-regime:csrc-c2a2": "python -m unittest discover -s scripts/tests -p test_market_regime_csrc_ipo_provenance.py",
    "data:fetch:market-regime:csrc-c2a2": "python -m scripts.market_regime.csrc_ipo_provenance fetch",
    "data:build:market-regime:csrc-c2a2": "python -m scripts.market_regime.csrc_ipo_provenance build",
    "data:validate:market-regime:csrc-c2a2": "python -m scripts.market_regime.csrc_ipo_provenance validate",
    "data:validate:market-regime:csrc-c2a2:compact": "python -m scripts.market_regime.csrc_ipo_provenance validate-compact",
    "data:build:market-regime:csrc-c2a1": "python -m scripts.market_regime.csrc_ipo_admission build",
    "data:validate:market-regime:csrc-c2a1": "python -m scripts.market_regime.csrc_ipo_admission validate",
    "data:validate:market-regime:csrc-c2a1:compact": "python -m scripts.market_regime.csrc_ipo_admission validate-compact",
    "data:validate:market-regime:csrc-recovery:compact": "python -m scripts.market_regime.csrc_recovery validate-compact",
    "data:fetch:market-regime:csrc-recovery": "python -m scripts.market_regime.csrc_recovery fetch",
    "data:build:market-regime:csrc-recovery": "python -m scripts.market_regime.csrc_recovery build",
    "data:validate:market-regime:csrc-recovery": "python -m scripts.market_regime.csrc_recovery validate",
    "data:fetch:market-regime:csrc-c1": "python -m scripts.market_regime.csrc_retrieval",
    "data:build:market-regime:csrc-c1": "python -m scripts.market_regime.csrc_inventory build",
    "data:validate:market-regime:csrc-c1": "python -m scripts.market_regime.csrc_inventory validate",
    "data:fetch:market-regime:pbc": "python -m scripts.market_regime.pbc_retrieval",
    "data:build:market-regime:pbc": "python -m scripts.market_regime.pbc_historical_cli build",
    "data:validate:market-regime:pbc": "python -m scripts.market_regime.pbc_historical_cli validate",
    "data:build:market-regime:historical": "python -m scripts.market_regime.historical_cli build --generated-at 2026-09-08T00:00:00Z --input scripts/tests/fixtures/market_regime/r2a-input.sample.v2.json --plans config/market-regime/historical-dataset-plans.sample.v2.json --output research-data/market-regime/catalog/historical-dataset.sample.v2.generated.json",
    "data:validate:market-regime:historical": "python -m scripts.market_regime.historical_cli validate --input scripts/tests/fixtures/market_regime/r2a-input.sample.v2.json --plans config/market-regime/historical-dataset-plans.sample.v2.json --output research-data/market-regime/catalog/historical-dataset.sample.v2.generated.json",
    "test:market-regime:catalog": "python -m unittest discover -s scripts/tests -p test_market_regime_catalog.py",
    "data:fetch:hk": "npm run data:universe && python scripts/fetch-hk-stock-data.py",
    "data:fetch:macro": "python scripts/fetch-macro-data.py",
    "data:validate": "npm run data:universe && python scripts/validate-a-stock-data.py",
    "data:validate:a-stock": "npm run data:universe && python scripts/validate-a-stock-data.py",
    "data:audit": "node scripts/data-audit.mjs",
    "data:refresh": "npm run data:universe && npm run data:fetch:a-stock && npm run data:fetch:hk && npm run data:fetch:macro && npm run data:validate:a-stock",
    "ui:audit": "node scripts/ui-audit.mjs",
    "agent:skills:setup": "node scripts/setup-codex-skills.mjs",
    "agent:skills:check": "node scripts/setup-codex-skills.mjs --check",
    "local:typecheck": "tsc -p tsconfig.local-core.json --noEmit",
    "local:db:verify": "node scripts/run-local-core.mjs verify",
    "test:contracts": "node scripts/run-local-core.mjs test-contracts && node --test scripts/tests/financial-research-contracts.node.mjs",
    "local:db:init": "node scripts/run-local-core.mjs init",
    "contracts:validate": "node scripts/run-local-core.mjs contracts && node scripts/contracts/financial-research.mjs",
    "test:local-core": "node scripts/run-local-core.mjs test-local-core",
    "test:assets": "node scripts/run-local-core.mjs test-assets",
    "test:semantic-runtime": "node --test scripts/tests/semantic-runtime.node.mjs scripts/tests/semantic-readiness.node.mjs",
    "data:query:macro": "node scripts/semantic-runtime/cli.mjs",
    "data:validate:semantic-bindings": "node scripts/semantic-runtime/bindings.mjs",
    "data:build:semantic-bindings": "node scripts/semantic-runtime/bindings.mjs --write",
    "data:validate:semantic-readiness": "node scripts/semantic-runtime/readiness.mjs",
    "data:build:semantic-readiness": "node scripts/semantic-runtime/readiness.mjs --write"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
