    td.c6  { text-align:right;  width:120px; padding-right: 10px; }

	td.l    { text-align:left;  width:570px; padding-left:5px;}
	td.float    { text-align:right; width:300px;}
	td.integer  { text-align:right; width:300px; padding-right:20px;}

</style>
