

<style>

	table { border-collapse:collapse; }
	caption { font-family:华文中宋; font-size:14pt; font-weight:bold; vertical-align:middle; text-align: left;padding-bottom:10px; }
	.title_cn { font-size: 13pt; line-height: 13pt; padding-bottom:5px; }
	.title_en { font-size: 12pt; line-height: 12pt; }

	th { padding: 2px; font-family:Tahoma,Verdana,Arial,Helvetica; font-size:9pt; line-height: 9pt; font-weight:bold; }
	td { padding: 3px; font-family:Tahoma,Verdana,Arial,Helvetica; font-size:9pt; line-height: 9pt; vertical-align:middle; text-align:right;}

	.center             { vertical-align:middle; text-align:center; }
	.top_line           { border-top:1px black solid; }
	.top_line_bold      { border-top:3px black solid; }
	.bottom_line        { border-bottom:1px black solid; }
	.bottom_line_bold   { border-bottom:3px black solid; }
	.separator          { border: none; width:0px; }

	tr.t1_top_row    td  { border-top:3px black solid; }
	tr.t1_bottom_row td  { border-bottom:1px black solid; }

	tr.t2_top_row    td  {}
	tr.t2_bottom_row td  { border-bottom:3px black solid; }

    td.c0  { text-align:left;   width:80px;  padding-left: 5px; }
