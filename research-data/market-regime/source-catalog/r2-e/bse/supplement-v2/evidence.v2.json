      "holidayLocators": [
        {
          "byteOffset": 15251,
          "byteLength": 669,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（一）元旦：1月</span><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\"><span style=\"font-family:微软雅黑\">1</span></span><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">日（星期四）至1月3日（星期六）休市。1月4日（星期日）为周末休市。1月5日（星期一）起照常开市。</span></p>"
        },
        {
          "byteOffset": 15920,
          "byteLength": 430,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（二）春节：2月15日（星期日）至2月23日（星期一）休市，2月14日（星期六）、2月28日（星期六）为周末休市。2月24日（星期二）起照常开市。</span></p>"
        },
        {
          "byteOffset": 16350,
          "byteLength": 361,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（三）清明节：4月4日（星期六）至4月6日（星期一）休市。4月7日（星期二）起照常开市。</span></p>"
        },
        {
          "byteOffset": 16711,
          "byteLength": 402,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（四）劳动节：5月1日（星期五）至5月5日（星期二）休市，5月9日（星期六）为周末休市。5月6日（星期三）起照常开市。</span></p>"
        },
        {
          "byteOffset": 17113,
          "byteLength": 364,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（五）端午节：6月19日（星期五）至6月21日（星期日）休市。6月22日（星期一）起照常开市。</span></p>"
        },
        {
          "byteOffset": 17477,
          "byteLength": 364,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（六）中秋节：9月25日（星期五）至9月27日（星期日）休市。9月28日（星期一）起照常开市。</span></p>"
        },
        {
          "byteOffset": 17841,
          "byteLength": 434,
          "text": "<p style=\";text-align: justify;font-family: Calibri;font-size: 14px;white-space: normal;text-indent: 31px;line-height: 28px\"><span style=\"font-family: 微软雅黑;line-height: 30.6667px;color: rgb(109, 109, 109);font-size: 15px\">（七）国庆节：10月1日（星期四）至10月7日（星期三）休市，9月20日（星期日）、10月10日（星期六）为周末休市。10月8日（星期四）起照常开市。</span></p>"
        }
