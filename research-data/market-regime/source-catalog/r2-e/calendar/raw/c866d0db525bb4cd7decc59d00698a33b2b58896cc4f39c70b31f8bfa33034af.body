  if(col_id=="8319" && location.href.indexOf("/c/")>0){
    pageTitle = "一般公告"
    $(".js_page-title").text("一般公告");
  }
  if(col_id=="8458" && location.href.indexOf("/c/")>0){
    pageTitle = "信息披露和动态"
    $(".js_page-title").text("信息披露和动态");
  }
  if(col_id=="20139" && location.href.indexOf("/c/")>0){
