<script>
                          function videoChangeSrc(){
	                  var videoBox = $('.video-container');
	                  if(videoBox.length >0){
		              for(var i=0; i<videoBox.length;i++){
			          var item = videoBox[i];
			          var href = $('a',item).attr('href');
			          $('video',item).attr('src',href);
		              }
	                  }
                      }
                      videoChangeSrc();
</script>
