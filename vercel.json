{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/bridge/resource-metadata" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/bridge/resource-metadata" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/bridge/oauth-metadata" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
