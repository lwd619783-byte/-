{
  "git": {
    "deploymentEnabled": {
      "codex/synthetic-demo-rebuild-20261016": false,
      "feat/research-os-round1-no-deploy": false
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/os-mcp",
      "destination": "/api/os-domain?action=resource-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/os-domain",
      "destination": "/api/os-domain?action=oauth-metadata"
    },
    {
      "source": "/api/os-domain/:action",
      "destination": "/api/os-domain?action=:action"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/review-mcp",
      "destination": "/api/daily-review?action=resource-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server/daily-review",
      "destination": "/api/daily-review?action=oauth-metadata"
    },
    {
      "source": "/api/daily-review/:action",
      "destination": "/api/daily-review?action=:action"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/research-bridge?action=resource-metadata"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/research-bridge?action=resource-metadata"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/research-bridge?action=oauth-metadata"
    },
    {
      "source": "/api/bridge/:action",
      "destination": "/api/research-bridge?action=:action"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
