{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource/api/os-mcp", "destination": "/api/os-domain?action=resource-metadata" },
    { "source": "/.well-known/oauth-authorization-server/os-domain", "destination": "/api/os-domain?action=oauth-metadata" },
    { "source": "/api/os-domain/:action", "destination": "/api/os-domain?action=:action" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/research-bridge?action=resource-metadata" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/research-bridge?action=resource-metadata" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/research-bridge?action=oauth-metadata" },
    { "source": "/api/bridge/:action", "destination": "/api/research-bridge?action=:action" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
