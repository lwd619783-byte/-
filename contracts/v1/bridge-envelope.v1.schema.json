{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-dashboard.local/contracts/v1/bridge-envelope.v1.schema.json",
  "title": "Research Bridge Response Envelope V1",
  "type": "object",
  "required": ["schemaVersion", "requestId", "status", "quality", "provenance"],
  "properties": {
    "schemaVersion": { "const": "research-bridge.v1" },
    "requestId": { "type": "string", "minLength": 1 },
    "asOf": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["ok", "partial", "error", "conflicted", "needs_confirmation", "needs_resolution"] },
    "data": {},
    "quality": {
      "type": "object",
      "required": ["status", "warnings"],
      "properties": {
        "status": { "type": "string", "enum": ["real", "partial", "stale", "missing", "not_implemented", "conflicted", "candidate"] },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["refType", "refId"],
        "properties": {
          "refType": { "type": "string" },
          "refId": { "type": "string", "minLength": 1 },
          "asOf": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "version": { "type": "integer", "minimum": 0 },
    "error": {
      "type": "object",
      "required": ["code", "messageZh"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "ENTITY_RESOLUTION_REQUIRED",
            "VERSION_CONFLICT",
            "PLAN_EXPIRED",
            "DIGEST_MISMATCH",
            "IDEMPOTENCY_CONFLICT",
            "CONFIRMATION_REQUIRED",
            "PERMISSION_DENIED",
            "RECONCILIATION_FAILED",
            "BACKUP_VERIFICATION_FAILED",
            "RESTORE_BLOCKED",
            "INTERNAL_ERROR"
          ]
        },
        "messageZh": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$comment": "服务端必须保留 missing/stale/partial/candidate 语义，不得把缺失值变成 0，不得把推断变成事实。"
}
