{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json",
  "$defs": {
    "query": {
      "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Query"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "universe",
        "coverage",
        "admission",
        "conflict",
        "freshness"
      ],
      "properties": {
        "entity": {
          "$ref": "https://investment-dashboard.local/contracts/v1/research-asset-os.contracts.v1.schema.json#/$defs/EntityRef"
        },
        "universe": {
          "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Pin"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetCount",
            "availableCount"
          ],
          "properties": {
            "targetCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "availableCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "admission": {
          "enum": [
            "ADMITTED",
            "PARTIAL",
            "NOT_ADMITTED",
            "UNKNOWN"
          ]
        },
        "conflict": {
          "enum": [
            "CLEAR",
            "CONFLICTED",
            "UNKNOWN"
          ]
        },
        "freshness": {
          "enum": [
            "FRESH",
            "STALE",
            "UNKNOWN"
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "condition",
        "refs"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "condition": {
          "enum": [
            "missing_evidence",
            "partial",
            "stale",
            "conflicted",
            "not_admitted",
            "unknown"
          ]
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "value",
    "unit",
    "selectedRefs",
    "evidenceRefs",
    "conditions",
    "blockers",
    "temporal",
    "lineage",
    "quality",
    "coverage",
    "admission",
    "conflict",
    "freshness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "macro-semantic-result.v1"
    },
    "outcome": {
      "enum": [
        "eligible",
        "blocked",
        "missing",
        "conflicted"
      ]
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Conditions"
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "temporal": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observationDate",
          "publicationDateTime",
          "publicationDate",
          "releaseAvailableAt",
          "releaseConfidenceClass",
          "effectiveFrom",
          "effectiveTo",
          "revisionSequence",
          "supersedesObservationId"
        ],
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1
          },
          "observationDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}(?:-\\d{2})?$"
          },
          "publicationDateTime": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "publicationDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "releaseAvailableAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "releaseConfidenceClass": {
            "enum": [
              "EXACT_TIMESTAMP",
              "DATE_ONLY_SAFE",
              "SCHEDULE_INFERRED",
              "LATEST_REVISED_PROXY",
              "BACKCAST_RELEASED_LATER",
              "STRUCTURALLY_UNAVAILABLE",
              null
            ]
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "effectiveTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "revisionSequence": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "supersedesObservationId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "sourceDefinitionId",
          "rawArtifactId",
          "transformVersion"
        ],
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceDefinitionId": {
            "type": "string",
            "minLength": 1
          },
          "rawArtifactId": {
            "type": "string",
            "minLength": 1
          },
          "transformVersion": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "quality": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "$ref": "#/$defs/context/properties/coverage"
    },
    "admission": {
      "$ref": "#/$defs/context/properties/admission"
    },
    "conflict": {
      "$ref": "#/$defs/context/properties/conflict"
    },
    "freshness": {
      "$ref": "#/$defs/context/properties/freshness"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "eligible"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "blockers": {
            "type": "array",
            "maxItems": 0
          },
          "conditions": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "null"
          },
          "unit": {
            "type": "null"
          }
        }
      }
    }
  ]
}
