{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://investment-research.local/contracts/stage-4-1/v1/readiness.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportKind", "assessmentScope", "datasetAsOf", "overallStatus", "statusCounts", "progressCounts", "gatePolicy", "productionAdmitted", "historyMaturityMinimum", "interpretation", "inputReferences", "metrics", "sourceEvidence", "verification"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "reportKind": {"const": "STAGE_4_1_SEMANTIC_READINESS"},
    "assessmentScope": {"const": "COMMITTED_COMPACT_EVIDENCE_ONLY"},
    "datasetAsOf": {"type": "string", "minLength": 1},
    "overallStatus": {"enum": ["READY", "BLOCKED"]},
    "statusCounts": {"type": "object", "additionalProperties": false, "required": ["READY", "BLOCKED"], "properties": {"READY": {"type": "integer", "minimum": 0}, "BLOCKED": {"type": "integer", "minimum": 0}}},
    "progressCounts": {"type": "object", "additionalProperties": false, "required": ["PARTIAL", "NOT_PROVEN"], "properties": {"PARTIAL": {"type": "integer", "minimum": 0}, "NOT_PROVEN": {"type": "integer", "minimum": 0}}},
    "gatePolicy": {"type": "object", "additionalProperties": false, "required": ["normalizationGates", "pitBacktestGates", "overallRule", "unknownRule", "methodologyReferences", "rationale"], "properties": {"normalizationGates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}, "pitBacktestGates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}, "overallRule": {"const": "BOTH_READY"}, "unknownRule": {"const": "BLOCKED"}, "methodologyReferences": {"$ref": "#/$defs/refs"}, "rationale": {"type": "string", "minLength": 1}}},
    "productionAdmitted": {"const": false},
    "historyMaturityMinimum": {"type": "object", "additionalProperties": false, "required": ["dailyObservations", "weeklyObservations", "monthlyObservations", "quarterlyObservations"], "properties": {"dailyObservations": {"const": 252}, "weeklyObservations": {"const": 52}, "monthlyObservations": {"const": 24}, "quarterlyObservations": {"const": 12}}},
    "interpretation": {"type": "string", "minLength": 1},
    "inputReferences": {"$ref": "#/$defs/refs"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}},
    "sourceEvidence": {"type": "object", "required": ["pbc", "csrc", "allA"], "additionalProperties": false, "properties": {"pbc": {"type": "object"}, "csrc": {"type": "object"}, "allA": {"type": "object"}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["compactConsistency", "fullRawReplay", "normalization", "backtest", "productionAdmission"], "properties": {
      "compactConsistency": {"const": "DERIVED_FROM_COMMITTED_INPUTS"},
      "fullRawReplay": {"const": "NOT_RUN"},
      "normalization": {"const": "NOT_RUN"},
      "backtest": {"const": "NOT_RUN"},
      "productionAdmission": {"const": "NOT_GRANTED"}
    }}
  },
  "$defs": {
    "refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "count": {"type": ["integer", "null"], "minimum": 0},
    "counts": {"type": "object", "additionalProperties": false, "required": ["candidateCount", "formalCount", "strictPitCount", "targetCount", "coveragePercent"], "properties": {
      "candidateCount": {"$ref": "#/$defs/count"}, "formalCount": {"$ref": "#/$defs/count"}, "strictPitCount": {"$ref": "#/$defs/count"}, "targetCount": {"$ref": "#/$defs/count"}, "coveragePercent": {"type": ["number", "null"], "minimum": 0, "maximum": 100}
    }},
    "metric": {"type": "object", "additionalProperties": false, "required": ["metricId", "readiness", "normalizationReadiness", "pitBacktestReadiness", "progress", "dependencies", "counts", "requiredGates", "gateChecks", "blockers", "evidenceReferences"], "properties": {
      "metricId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "readiness": {"enum": ["READY", "BLOCKED"]}, "progress": {"enum": ["PARTIAL", "NOT_PROVEN"]},
      "normalizationReadiness": {"enum": ["READY", "BLOCKED"]}, "pitBacktestReadiness": {"enum": ["READY", "BLOCKED"]},
      "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "counts": {"$ref": "#/$defs/counts"},
      "requiredGates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
      "gateChecks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["gate", "status", "evidenceReferences", "blockerCodes"], "properties": {"gate": {"type": "string"}, "status": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]}, "evidenceReferences": {"$ref": "#/$defs/refs"}, "blockerCodes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}},
      "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "detail", "evidenceReferences"], "properties": {"code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}, "detail": {"type": "string", "minLength": 1}, "evidenceReferences": {"$ref": "#/$defs/refs"}}}},
      "evidenceReferences": {"$ref": "#/$defs/refs"}
    }}
  }
}
