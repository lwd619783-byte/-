{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-dashboard.local/contracts/knowledge-ingestion/v1/contribution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "batchId",
    "createdAt",
    "sourceRefs",
    "extractions",
    "knowledgeAtoms",
    "conflicts",
    "uncertainty",
    "proposals"
  ],
  "properties": {
    "schemaVersion": {
      "const": "knowledge-contribution.v1"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "batchId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRef",
          "sha256"
        ],
        "properties": {
          "sourceRef": {
            "$ref": "https://investment-dashboard.local/contracts/research-extraction/v1/research-extraction.schema.json#/$defs/ResearchSourceRef"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "extractions": {
      "type": "array",
      "items": {
        "$ref": "https://investment-dashboard.local/contracts/research-extraction/v1/research-extraction.schema.json#/$defs/ResearchExtraction"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "knowledgeAtoms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atomId",
          "extractionId",
          "findingIndex",
          "citations"
        ],
        "properties": {
          "atomId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "extractionId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
          },
          "findingIndex": {
            "type": "integer",
            "minimum": 0
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceRef",
                "locator",
                "quote"
              ],
              "properties": {
                "sourceRef": {
                  "$ref": "https://investment-dashboard.local/contracts/research-extraction/v1/research-extraction.schema.json#/$defs/ResearchSourceRef"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                }
              }
            },
            "minItems": 1,
            "maxItems": 1000
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "citations"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 200000
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceRef",
                "locator",
                "quote"
              ],
              "properties": {
                "sourceRef": {
                  "$ref": "https://investment-dashboard.local/contracts/research-extraction/v1/research-extraction.schema.json#/$defs/ResearchSourceRef"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                }
              }
            },
            "minItems": 1,
            "maxItems": 1000
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 200000
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposalId",
          "action",
          "wikiId",
          "baseRevisionId",
          "wikiType",
          "document",
          "changes",
          "citations",
          "extractionIds",
          "linkedWikiIds",
          "uncertainty",
          "rationale"
        ],
        "properties": {
          "proposalId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "action": {
            "enum": [
              "CREATE",
              "UPDATE",
              "LINK",
              "CONFLICT",
              "NO_ACTION"
            ]
          },
          "wikiId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 200000
              },
              {
                "type": "null"
              }
            ]
          },
          "baseRevisionId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 200000
              },
              {
                "type": "null"
              }
            ]
          },
          "wikiType": {
            "enum": [
              "ENTITY",
              "CONCEPT",
              "FRAMEWORK",
              "TOPIC",
              "CREATOR_FRAMEWORK",
              "INDUSTRY_KNOWLEDGE",
              "MACRO_KNOWLEDGE",
              "RESEARCH_CONVENTION"
            ]
          },
          "document": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "summary",
                  "bodyMarkdown"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "maxLength": 200000
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "maxLength": 200000
                  },
                  "bodyMarkdown": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "maxLength": 200000
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "section",
                "kind",
                "summary",
                "citations"
              ],
              "properties": {
                "section": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                },
                "kind": {
                  "enum": [
                    "ADD",
                    "MODIFY",
                    "REMOVE",
                    "LOWER_CONFIDENCE"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sourceRef",
                      "locator",
                      "quote"
                    ],
                    "properties": {
                      "sourceRef": {
                        "$ref": "https://investment-dashboard.local/contracts/research-extraction/v1/research-extraction.schema.json#/$defs/ResearchSourceRef"
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S",
                        "maxLength": 200000
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S",
                        "maxLength": 200000
                      }
                    }
                  },
                  "minItems": 1,
                  "maxItems": 1000
                }
              }
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sourceRef",
                "locator",
                "quote"
              ],
              "properties": {
                "sourceRef": {
                  "$ref": "https://investment-dashboard.local/contracts/research-extraction/v1/research-extraction.schema.json#/$defs/ResearchSourceRef"
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 200000
                }
              }
            },
            "minItems": 1,
            "maxItems": 1000
          },
          "extractionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "linkedWikiIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 200000
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 200000
            },
            "minItems": 0,
            "maxItems": 1000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "maxLength": 200000
          }
        }
      },
      "minItems": 1,
      "maxItems": 1000
    }
  }
}
