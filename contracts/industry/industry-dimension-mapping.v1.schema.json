{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-dashboard.local/contracts/industry/industry-dimension-mapping.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "industry-dimension-mapping.v1"
    },
    "id": {
      "const": "industry-dimension-mapping"
    },
    "revision": {
      "const": "1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "industryId",
          "metricId",
          "definitionRef",
          "dimension"
        ],
        "properties": {
          "industryId": {
            "type": "string",
            "minLength": 1
          },
          "metricId": {
            "type": "string",
            "minLength": 1
          },
          "definitionRef": {
            "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Pin"
          },
          "dimension": {
            "enum": [
              "demand",
              "supply",
              "inventory",
              "price",
              "margin",
              "utilization",
              "capex",
              "policy",
              "valuation",
              "trading_state",
              "trade_flow"
            ]
          },
          "subdimension": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
