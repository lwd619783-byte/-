{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "definition",
    "policy",
    "definitionRef",
    "observations",
    "completeness"
  ],
  "properties": {
    "schemaVersion": {
      "const": "industry-metric.v1"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "definition": {
      "$ref": "#/$defs/definition"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "definitionRef": {
      "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Pin"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "historicalCoverage"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "monthlyAvailable": {
          "type": "integer",
          "minimum": 0
        },
        "monthlyTarget": {
          "type": "integer",
          "minimum": 0
        },
        "missingMonthlyPeriods": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "uniqueItems": true
        },
        "historicalCoverage": {
          "type": "string",
          "minLength": 1
        },
        "availableCount": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/coverage/properties/availableCount"
        },
        "targetCount": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/coverage/properties/targetCount"
        },
        "missingPeriods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/period"
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "monthlyAvailable",
            "monthlyTarget",
            "missingMonthlyPeriods"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "availableCount"
                ]
              },
              {
                "required": [
                  "targetCount"
                ]
              },
              {
                "required": [
                  "missingPeriods"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "availableCount",
            "targetCount",
            "missingPeriods"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "monthlyAvailable"
                ]
              },
              {
                "required": [
                  "monthlyTarget"
                ]
              },
              {
                "required": [
                  "missingMonthlyPeriods"
                ]
              }
            ]
          }
        }
      ],
      "description": "Generic coverage uses availableCount/targetCount/missingPeriods. The monthly-named group is retained for existing V1 artifacts. Scope and denominator are owner-defined; counts do not grant admission."
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investment-dashboard.local/contracts/industry/industry-metric.v1.schema.json",
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "canonicalName",
        "industryId",
        "entity",
        "geography",
        "scope",
        "unit",
        "nativeFrequency",
        "basis",
        "sourceId",
        "sourceOwner",
        "acquisitionAdapter",
        "revisionPolicy",
        "window",
        "freshness",
        "staleAfter"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "canonicalName": {
          "type": "string",
          "minLength": 1
        },
        "industryId": {
          "type": "string",
          "minLength": 1
        },
        "entity": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v2/semantic-runtime.schema.json#/properties/identityResolution/properties/entity"
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "nativeFrequency": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Owner-defined reporting basis, as in F1 reportingBasis; different bases are not interchangeable."
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceOwner": {
          "type": "string",
          "minLength": 1
        },
        "acquisitionAdapter": {
          "type": "string",
          "minLength": 1
        },
        "revisionPolicy": {
          "type": "string",
          "minLength": 1
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/period"
            },
            "end": {
              "$ref": "#/$defs/period"
            }
          }
        },
        "missingMonthlyPeriods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          }
        },
        "freshness": {
          "anyOf": [
            {
              "const": "unknown"
            },
            {
              "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/freshness"
            }
          ],
          "description": "Existing semantic freshness vocabulary; lowercase unknown retained for the original V1 artifact."
        },
        "staleAfter": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "missingPeriods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/period"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "entityResolution",
        "dataAdmission",
        "productionAdmission",
        "allowedUses",
        "forbiddenUses",
        "previewUse"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "entityResolution": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v2/semantic-runtime.schema.json#/properties/identityResolution/properties/status"
        },
        "dataAdmission": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/admission"
        },
        "productionAdmission": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/admission"
        },
        "allowedUses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Query/properties/use"
          }
        },
        "forbiddenUses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Query/properties/use"
          }
        },
        "previewUse": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "metricId",
        "industryId",
        "geography",
        "scope",
        "unit",
        "frequency",
        "basis",
        "valueDate",
        "referencePeriod",
        "value",
        "publicationDateTime",
        "releaseAvailableAt",
        "acquiredAt",
        "generatedAt",
        "revision",
        "quality",
        "conditions",
        "pit",
        "dataAdmission",
        "productionAdmission",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "metricId": {
          "type": "string",
          "minLength": 1
        },
        "industryId": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "valueDate": {
          "$ref": "#/$defs/period"
        },
        "referencePeriod": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "#/$defs/period"
            },
            "end": {
              "$ref": "#/$defs/period"
            }
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "publicationDateTime": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "releaseAvailableAt": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/properties/temporal/items/properties/releaseAvailableAt"
        },
        "acquiredAt": {
          "type": "string",
          "format": "date-time"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "sequence",
            "supersedes",
            "retainedVintage"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1,
              "description": "Owner-defined revision status, governed by definition.revisionPolicy; unknown is not a permanent restriction. Sequence/supersedes reuse semantic runtime fields, not acquisition ordering."
            },
            "sequence": {
              "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/properties/temporal/items/properties/revisionSequence"
            },
            "supersedes": {
              "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/properties/temporal/items/properties/supersedesObservationId"
            },
            "retainedVintage": {
              "type": "string"
            }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "status"
          ],
          "properties": {
            "source": {
              "type": "string"
            },
            "sourceLayer": {
              "type": "string",
              "minLength": 1
            },
            "sourceEndpoint": {
              "type": "string"
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "status": {
              "enum": [
                "mock",
                "real",
                "partial",
                "stale",
                "missing",
                "error",
                "not_implemented",
                "unsupported_market",
                "conflicted",
                "source_unavailable",
                "generated_real",
                "manual_verified",
                "manual_unverified",
                "static_reference",
                "inferred",
                "placeholder",
                "unknown"
              ],
              "description": "Existing DataQualityMeta status vocabulary (DataSourceStatus | EvidenceSourceType)."
            },
            "updatedAt": {
              "type": "string"
            },
            "errorMessage": {
              "type": "string"
            }
          }
        },
        "conditions": {
          "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Conditions"
        },
        "pit": {
          "enum": [
            "PROVEN",
            "UNPROVED"
          ],
          "description": "Existing owner/chart proof marker only. PROVEN requires the owner to establish PIT under existing semantic vintage/release gates; schema success is not proof."
        },
        "dataAdmission": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/admission"
        },
        "productionAdmission": {
          "$ref": "https://investment-dashboard.local/contracts/stage-4-1/v1/semantic-runtime.schema.json#/$defs/context/properties/admission"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "sourceOwner",
            "acquisitionAdapter",
            "rawPath",
            "rawSha256",
            "captureRef",
            "locator",
            "transformVersion",
            "evidence"
          ],
          "properties": {
            "sourceId": {
              "type": "string"
            },
            "sourceOwner": {
              "type": "string"
            },
            "acquisitionAdapter": {
              "type": "string"
            },
            "rawPath": {
              "type": "string"
            },
            "rawSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "captureRef": {
              "$ref": "https://investment-dashboard.local/contracts/financial-research/v1/shared.schema.json#/$defs/Pin"
            },
            "locator": {
              "type": "string"
            },
            "column": {
              "type": "integer",
              "minimum": 0
            },
            "rawRow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "transformVersion": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "https://investment-dashboard.local/contracts/v1/research-asset-os.contracts.v1.schema.json#/$defs/EvidenceRef"
            }
          }
        }
      }
    },
    "period": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        {
          "type": "string",
          "format": "date"
        }
      ]
    }
  },
  "description": "Reusable Industry Metric V1 wire contract. Validation describes representable states; it does not prove identity, PIT, revision continuity or admission. Each owner must enforce its reviewed policy, binding and source replay separately."
}
